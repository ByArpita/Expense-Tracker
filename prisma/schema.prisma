generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Expense {
  id          String   @id @default(uuid())
  amount      Float
  category    String
  description String
  createdAt   DateTime

  @@index([createdAt])
  @@index([category])
}
